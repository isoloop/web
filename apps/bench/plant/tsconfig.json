{
  // Its own settings, not the repo's tsconfig.base.json: plant-bench changes
  // only at a generation (README.md), so nothing on main reaches it.
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    // What the Isoloop build's aliases point at; env/match.ts checks the
    // native builds' #env has the same API.
    "paths": {
      "#env": ["./src/env/isoloop.ts"],
      "#slot": ["./src/slot/isoloop.tsx"],
      "#main": ["./src/main.isoloop.tsx"],
      "#metrics": ["./src/metrics/isoloop.ts"],
      "#host": ["./src/host/isoloop.ts"]
    }
  },
  "include": ["src", "e2e", "lib", "scripts", "*.ts"]
}

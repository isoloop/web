{
  "name": "plant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A telemetry dashboard for a fictional plant of eight machines: native, native with workers, and on Isoloop.",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner && vite build --configLoader runner --mode native && vite build --configLoader runner --mode native-workers && vite build --configLoader runner --config vite.interactive.config.ts && vite build --configLoader runner --config vite.interactive.config.ts --mode native && node scripts/index-page.ts && node scripts/check-builds.ts && node scripts/build-stats.ts",
    "preview": "vite preview --configLoader runner --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "compare": "playwright test --project=comparison --project=comparison-firefox --project=comparison-webkit --workers=1; node scripts/compare.ts",
    "compare:pairs": "node comparison/run.ts",
    "compare:interactive": "node comparison/interactive.ts",
    "dev:native": "vite --configLoader runner --mode native",
    "dev:native-workers": "vite --configLoader runner --mode native-workers",
    "dev:interactive": "vite --configLoader runner --config vite.interactive.config.ts",
    "dev:interactive-native": "vite --configLoader runner --config vite.interactive.config.ts --mode native"
  },
  "dependencies": {
    "@isoloop/balancer": "catalog:isoloop",
    "@isoloop/bus": "catalog:isoloop",
    "@isoloop/host": "catalog:isoloop",
    "@isoloop/protocol": "catalog:isoloop",
    "@isoloop/react": "catalog:isoloop",
    "@isoloop/runtime": "catalog:isoloop",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@isoloop/codec": "catalog:isoloop",
    "@isoloop/vite": "catalog:isoloop",
    "@playwright/test": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "compare": "workspace:*",
    "creator": "workspace:*",
    "typescript": "catalog:",
    "ui": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

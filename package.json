{
  "name": "isoloop-examples",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "e2e": "pnpm -r e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "release:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}

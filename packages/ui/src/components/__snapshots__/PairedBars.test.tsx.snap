// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PairedBars > renders the fixture as static SVG bars with the values and the delta in words 1`] = `"<figure class="ui-chart"><figcaption><span class="ui-chart-title">Main thread busy</span><span class="ui-chart-note">Lower is better.</span></figcaption><ol class="ui-chart-rows"><li class="ui-chart-row"><p class="ui-chart-label">1 kHz</p><div class="ui-chart-line" data-series="base"><span class="ui-chart-name">Native + workers</span><span class="ui-chart-track"><svg class="ui-chart-svg" width="41%" height="14" aria-hidden="true" focusable="false"><rect width="100%" height="14" rx="4"></rect><rect width="4" height="14"></rect></svg><span class="ui-chart-value">41%</span></span></div><div class="ui-chart-line" data-series="value" data-verdict="better"><span class="ui-chart-name">Isoloop matched</span><span class="ui-chart-track"><svg class="ui-chart-svg" width="15%" height="14" aria-hidden="true" focusable="false"><rect width="100%" height="14" rx="4"></rect><rect width="4" height="14"></rect></svg><span class="ui-chart-value">15%</span></span></div><p class="ui-chart-delta" data-verdict="better">26 points lower, better</p></li><li class="ui-chart-row"><p class="ui-chart-label">5 kHz</p><div class="ui-chart-line" data-series="base"><span class="ui-chart-name">Native + workers</span><span class="ui-chart-track"><svg class="ui-chart-svg" width="79%" height="14" aria-hidden="true" focusable="false"><rect width="100%" height="14" rx="4"></rect><rect width="4" height="14"></rect></svg><span class="ui-chart-value">79%</span></span></div><div class="ui-chart-line" data-series="value" data-verdict="better"><span class="ui-chart-name">Isoloop matched</span><span class="ui-chart-track"><svg class="ui-chart-svg" width="27%" height="14" aria-hidden="true" focusable="false"><rect width="100%" height="14" rx="4"></rect><rect width="4" height="14"></rect></svg><span class="ui-chart-value">27%</span></span></div><p class="ui-chart-delta" data-verdict="better">52 points lower, better</p></li></ol><ul class="ui-chart-legend" aria-label="How to read the charts"><li data-series="base">Native + workers</li><li data-series="value" data-verdict="better">Isoloop matched, better</li></ul></figure>"`;
